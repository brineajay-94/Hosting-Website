# Hosting website — Apache config (React SPA + PHP API)
Options -Indexes

DirectoryIndex index.html index.php

# Unknown routes go to the React SPA (it renders the 404 page client-side)
ErrorDocument 404 /index.html

# Basic security headers (only if your host allows mod_headers)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Protect sensitive files
<FilesMatch "^(config\.php|database\.sql)$">
    Require all denied
</FilesMatch>

# Block the CLI-only admin creator from the web (safe: it needs a CLI anyway).
# check.php is intentionally NOT blocked — it is the setup diagnostic.
<FilesMatch "^(create-admin\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# React SPA rewrite + dynamic robots/sitemap
<IfModule mod_rewrite.c>
    RewriteEngine On

    # robots.txt/sitemap.xml are generated by PHP so the domain always matches
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Real files and folders are served directly; everything else falls
    # through to index.html so client-side routing works.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>